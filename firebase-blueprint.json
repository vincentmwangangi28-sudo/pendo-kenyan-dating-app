{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "Information about a user.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "User's full name" },
        "age": { "type": "number", "description": "User's age" },
        "location": { "type": "string", "description": "User's location" },
        "neighborhood": { "type": "string", "description": "User's neighborhood" },
        "bio": { "type": "string" },
        "interests": { "type": "array", "items": { "type": "string" } },
        "languages": { "type": "array", "items": { "type": "string" } },
        "gender": { "type": "string" },
        "lookingFor": { "type": "string" },
        "photoUrl": { "type": "string" },
        "voiceUrl": { "type": "string" },
        "boostExpiresAt": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "trustScore": { "type": "number" },
        "subscriptionTier": { "type": "string" },
        "vibeCircle": { "type": "string", "description": "Kenyan Vibe Circle lifestyle tag" },
        "recommendedVibeCircle": { "type": "string", "description": "Quiz recommended circle" },
        "vibeQuizCompleted": { "type": "boolean" },
        "ageVerified": { "type": "boolean" },
        "dataSaverEnabled": { "type": "boolean" },
        "coordinates": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" }
          }
        }
      },
      "required": ["name", "age", "location", "bio"]
    },
    "voiceRoom": {
      "title": "Voice Room",
      "description": "Information about a temporary, ephemeral voice room.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "userId": { "type": "string" },
              "name": { "type": "string" },
              "isMuted": { "type": "boolean" },
              "isSpeaking": { "type": "boolean" },
              "joinedAt": { "type": "number" }
            }
          }
        }
      },
      "required": ["name", "creatorId", "creatorName", "createdAt", "expiresAt", "participants"]
    },
    "swipe": {
      "title": "Directional Swipe",
      "description": "Records a user's LIKE or PASS action on another profile.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "action": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "targetId", "action", "createdAt"]
    },
    "safetyCheckin": {
      "title": "Date Safety Check-In",
      "description": "Live Date Safety Check-In record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "matchName": { "type": "string" },
        "venueName": { "type": "string" },
        "city": { "type": "string" },
        "emergencyContactName": { "type": "string" },
        "emergencyContactPhone": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" },
        "checkInBy": { "type": "number" }
      },
      "required": ["userId", "userName", "matchName", "venueName", "city", "emergencyContactName", "emergencyContactPhone", "status", "createdAt"]
    },
    "vibeMeetupRsvp": {
      "title": "Vibe Meetup RSVP",
      "description": "RSVP record for a Kenyan Vibe Circle meetup event.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "vibeCircle": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["eventId", "userId", "userName", "vibeCircle", "status", "createdAt"]
    },
    "notificationItem": {
      "title": "User Notification",
      "description": "Real-time notification item for matches, free Zawadi gifts, and meetup RSVPs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "type", "title", "body", "read", "createdAt"]
    },
    "adminSettings": {
      "title": "Admin Launch & Store State",
      "description": "Private checklist and store configuration state strictly owned by Vincent Mwangangi.",
      "type": "object",
      "properties": {
        "ownerEmail": { "type": "string" },
        "updatedAt": { "type": "number" },
        "completedSteps": { "type": "object" },
        "androidSha256": { "type": "string" },
        "appleTeamId": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["ownerEmail", "updatedAt", "completedSteps"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/userProfile" },
      "description": "User profiles. Users can only edit their own profile."
    },
    "/voiceRooms/{roomId}": {
      "schema": { "$ref": "#/entities/voiceRoom" },
      "description": "Ephemeral voice rooms. Anyone signed in can read and join, host can delete."
    },
    "/swipes/{swipeId}": {
      "schema": { "$ref": "#/entities/swipe" },
      "description": "Directional swipes by signed-in users."
    },
    "/safetyCheckins/{checkinId}": {
      "schema": { "$ref": "#/entities/safetyCheckin" },
      "description": "Live Date Safety Check-In beacons created by users."
    },
    "/vibeMeetups/{eventId}/rsvps/{userId}": {
      "schema": { "$ref": "#/entities/vibeMeetupRsvp" },
      "description": "Vibe Circle meetup RSVPs owned by the signed-in user."
    },
    "/notifications/{userId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/notificationItem" },
      "description": "Private real-time user notification inbox."
    },
    "/adminSettings/{docId}": {
      "schema": { "$ref": "#/entities/adminSettings" },
      "description": "Private admin launch state strictly accessible only by verified admin email vincentmwangangi28@gmail.com."
    },
    "/test/connection": {
      "schema": "any",
      "description": "Test connection document (authenticated read)."
    }
  }
}
