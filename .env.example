# Render Web Service Environment Variables
NODE_ENV=production
PORT=3000
GEMINI_API_KEY=
RENDER_EXTERNAL_URL=https://www.pendo.website
RENDER_DEPLOY_HOOK_URL=

# Render Managed PostgreSQL (Optional - auto-injected if linked in Render)
DATABASE_URL=

# Cloud SQL / Postgres Database Credentials (Fallback if using individual variables)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# Ahrefs Site Audit v3 API (Server-side Admin Diagnostics Only)
AHREFS_API_KEY=
AHREFS_PROJECT_ID=10647395
