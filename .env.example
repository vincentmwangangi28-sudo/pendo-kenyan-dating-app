# Render Web Service Environment Variables
NODE_ENV=production
PORT=3000
GEMINI_API_KEY=
RENDER_EXTERNAL_URL=https://www.pendo.website
RENDER_DEPLOY_HOOK_URL=

# M-Pesa Daraja 2.0 Credentials (Optional - sandbox verification runs when omitted)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://www.pendo.website/api/mpesa/callback

# Render Managed PostgreSQL (Optional - auto-injected if linked in Render)
DATABASE_URL=

# Cloud SQL / Postgres Database Credentials (Fallback if using individual variables)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
